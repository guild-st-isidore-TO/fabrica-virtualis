digraph {
    label = "\nFaVirtu\nSystem and modules\nv1.1";
    node [shape = box;];
    
    user -> tabaeth;
    
    tabaeth -> edimeli;
    tabaeth -> edtab;
    tabaeth -> matte;
    tabaeth -> archalc;
    
    tabaeth -> librext;
    
    tabaeth -> arcodi;
    edimeli -> arcodi;
    edtab -> arcodi;
    matte -> arcodi;
    archalc -> arcodi;
    
    user [label = "User";colorscheme=set19;color = 1;];
    
    subgraph cluster_0 {
        label = "System Modules";
        color = black;
        bgcolor = grey93;
        penwidth = 1.5;
        node [bgcolor = white;];
        
        tabaeth [label = "Tabula Aetherea\nEthereal Tablet";colorscheme=set19;color = 2;];
    }
    subgraph cluster_1 {
        label = "API Modules";
        color = black;
        bgcolor = grey93;
        penwidth = 1.5;
        node [bgcolor = white;];
        
        archalc [label = "Editoris Melicorum\nEditors of Melodies";colorscheme=set19;color = 3;];
        matte [label = "Editoris Tabularum\nEditors of Documents";colorscheme=set19;color = 3;];
        edimeli [label = "Architectus Calculonis\nComputerized Architect";colorscheme=set19;color = 3;];
        edtab [label = "Manípulus Attestatiónum\nSheaf of Testimonies";colorscheme=set19;color = 3;];
    }
    
    subgraph cluster_2 {
        label = "Libraries";
        color = black;
        bgcolor = grey93;
        penwidth = 1.5;
        node [bgcolor = white;];
        
        librext [label = "Librarium Textuum\nLibrary of Frameworks";shape = cylinder;colorscheme=set19;color = 4;];
        arcodi [label = "Armamentarium Codicum\nArmory of Books";shape = cylinder;colorscheme=set19;color = 4;];
    }
}